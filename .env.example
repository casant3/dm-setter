# --- OpenAI (the setter) --------------------------------------------------
# Without a key the app runs on a deterministic offline engine so the UI is
# usable, but the real setter needs this. Screenshot transcription also
# requires it and is never faked.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REVIEW_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vision model used by the ingestion pipeline. Defaults to OPENAI_MODEL.
OPENAI_VISION_MODEL=

# --- Supabase (source of truth) -------------------------------------------
# Server-side only. Never expose the service role key to the browser.
# Without these the app falls back to a local JSON store under .data/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication -------------------------------------------------------
# Either set APP_PASSWORD, or generate the hashed form with: npm run auth:setup
#
# APP_PASSWORD is the simplest and is what a hosted deployment normally uses:
# the password lives in the same encrypted environment as the Supabase key.
# The hashed form keeps the password itself out of the environment and is
# preferred where you can run the script. If both are set, the hash wins.
#
# Without either, the app refuses every request in production and runs open
# only in local development.
APP_PASSWORD=
APP_PASSWORD_SALT=
APP_PASSWORD_HASH=
SESSION_SECRET=

# --- Behaviour ------------------------------------------------------------
# Whose voice the final DM should imitate. Strategy is still learned from the
# whole team; only phrasing is restricted to this setter.
SETTER_VOICE=Cassey

# --- Development ----------------------------------------------------------
# Force the local store even when Supabase credentials are present.
FORCE_LOCAL_STORE=
# Directory for the local store (default: .data)
LOCAL_STORE_DIR=
# Set to 0 to silence operation logging.
DM_SETTER_LOG=
