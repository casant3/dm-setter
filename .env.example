# --- OpenAI ---------------------------------------------------------------
# Without a key the app runs on a deterministic offline engine so the UI is
# usable, but the real setter needs this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REVIEW_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase -------------------------------------------------------------
# Server-side only. Never expose the service role key to the browser.
# Without these the app falls back to a local JSON store under .data/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Development ----------------------------------------------------------
# Set to 1 to force the local store even when Supabase credentials are present.
FORCE_LOCAL_STORE=
# Directory for the local store (default: .data)
LOCAL_STORE_DIR=
